# AJZIO Education — optional server settings. Export before ./run.sh.
HSC_HOST=127.0.0.1
PORT=4173
# Set only for the first owner/admin account registration.
# HSC_ADMIN_EMAIL=you@example.com
# Optional persistent data directory (keep this on a durable disk).
# HSC_DATA_DIR=/srv/ajzio-education/data

# Optional Google OAuth. Leave unset to keep the Google button visible but disabled.
# Create a Google OAuth 2.0 Web application client and use the exact callback URI.
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-client-secret
# GOOGLE_REDIRECT_URI=http://127.0.0.1:4173/auth/google/callback
